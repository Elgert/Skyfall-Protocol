[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

2d_physics/layer_1="player"
2d_physics/layer_2="player_projectile"
2d_physics/layer_3="enemy"
2d_physics/layer_4="enemy_projectile"
2d_physics/layer_5="pickup"

[rendering]

